{
  "name": "dsh-mobile-rail",
  "version": "1.0.0",
  "private": true,
  "description": "Hide the collapsed sidebar rail on phones, open the real sidebar from a left-edge tap, and blank the squeezed remainder",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "license": "MIT"
}
